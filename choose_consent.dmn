  <decision id="ChooseConsentDT" name="ChooseConsentDT">
    <decisionTable id="DecisionTable_0lsdblf">
      <input id="Input_1" label="Mode">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>Mode</text>
        </inputExpression>
      </input>
      <input id="InputClause_1288rcq" label="Weight">
        <inputExpression id="LiteralExpression_0th0qer" typeRef="number">
          <text>Weight</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Consent" name="Consent" typeRef="string" />
      <rule id="DecisionRule_1cku0jv">
        <inputEntry id="UnaryTests_0i3dj2h">
          <text>"car"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ey4h3p">
          <text>&gt; 6</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0nj4fqn">
